<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">
    <Style src="RaFileSystem.uss" />
    <Style src="GameScreen.uss" />

    <ui:VisualElement name="game-screen" class="game-screen">

        <!-- Left: FileSystem -->
        <ui:VisualElement name="game-screen__left" class="game-screen__pane">
            <ui:VisualElement name="ra-window" class="ra-window">

                <ui:VisualElement name="ra-toolbar" class="ra-toolbar">
                    <ui:Button name="ra-back-button" text="←" class="ra-back-button" />
                    <ui:VisualElement name="ra-breadcrumb" class="ra-breadcrumb" />
                </ui:VisualElement>

                <ui:ScrollView name="ra-contents" class="ra-contents" />

                <ui:VisualElement name="ra-statusbar" class="ra-statusbar">
                    <ui:Label name="ra-status-label" text="" class="ra-status-label" />
                </ui:VisualElement>

            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Right: Requests -->
        <ui:VisualElement name="game-screen__right" class="game-screen__pane game-screen__pane--right">
            <ui:VisualElement name="req-window" class="req-window">

                <ui:VisualElement name="req-header" class="req-header">
                    <ui:Label name="req-title" text="Incoming Requests" class="req-title" />
                    <ui:Label name="req-count" text="" class="req-count" />
                </ui:VisualElement>

                <ui:ScrollView name="req-list" class="req-list" />

            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
