<?xml version="1.0" encoding="utf-8"?>
<ui:UXML xmlns:ui="UnityEngine.UIElements" xmlns:uie="UnityEditor.UIElements"
         editor-extension-mode="False">
    <Style src="RaFileSystem.uss" />
    <Style src="GameScreen.uss" />

    <ui:Template name="RaFileSystem" src="project://database/Assets/_Core/UI/RaFileSystem.uxml?fileID=9197481963319205126&amp;guid=201dff0eabfbfe74daed89fb234bbc23&amp;type=3#RaFileSystem" />

    <ui:VisualElement name="game-root" class="app">

        <!-- Top bar -->
        <ui:VisualElement name="topbar" class="topbar">
            <ui:VisualElement class="topbar-left">
                <ui:Label name="station-logo" text="[O]" class="station-logo" />
                <ui:VisualElement>
                    <ui:Label text="STATION ALPHA" class="station-name" />
                    <ui:Label text="OPERATOR TERMINAL - v1.33.7" class="station-sub" />
                </ui:VisualElement>
            </ui:VisualElement>
            <ui:VisualElement class="topbar-stats">
                <!-- Score & Streak -->
                <ui:VisualElement class="stat-group">
                    <ui:Label text="SCORE" class="stat-header" />
                    <ui:Label name="stat-score" text="0000" class="stat-value" />
                </ui:VisualElement>
                <ui:VisualElement class="stat-group">
                    <ui:Label text="STREAK" class="stat-header" />
                    <ui:Label name="stat-streak" text="x1" class="stat-value stat-value--info" />
                </ui:VisualElement>
                <!-- Station Integrity -->
                <ui:VisualElement class="integrity-container">
                    <ui:Label text="STATION INTEGRITY" class="stat-header" />
                    <ui:VisualElement class="integrity-bar">
                        <ui:VisualElement name="integrity-dot-1" class="integrity-dot integrity-dot--full" />
                        <ui:VisualElement name="integrity-dot-2" class="integrity-dot integrity-dot--full" />
                        <ui:VisualElement name="integrity-dot-3" class="integrity-dot integrity-dot--full" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Main split -->
        <ui:VisualElement name="main-content" class="main-content">

            <!-- Left: file system terminal -->
            <ui:VisualElement name="terminal-panel" class="terminal-panel">
                <ui:VisualElement class="terminal-header">
                    <ui:VisualElement class="td td--r" />
                    <ui:VisualElement class="td td--y" />
                    <ui:VisualElement class="td td--g" />
                    <ui:Label text="FILE SYSTEM" class="terminal-title" />
                </ui:VisualElement>
                <ui:Instance template="RaFileSystem" class="game-screen__fill" />
            </ui:VisualElement>

            <!-- Right: transmission chat + log -->
            <ui:VisualElement name="request-panel" class="request-panel">
                <ui:VisualElement class="chat-header">
                    <ui:VisualElement class="chat-header__left">
                        <ui:VisualElement name="chat-signal" class="chat-signal" />
                        <ui:Label name="chat-id" text="STANDBY" class="chat-id" />
                    </ui:VisualElement>
                    <ui:Label name="chat-timer" text="--:--" class="chat-timer" />
                </ui:VisualElement>

                <ui:ScrollView name="chat-messages" class="chat-messages" />

                <ui:VisualElement name="chat-typing" class="chat-typing msg" />

                <ui:VisualElement class="chat-input-row">
                    <ui:TextField name="chat-input" class="chat-input" />
                    <ui:Button name="chat-send" text="&gt;" class="chat-send" />
                </ui:VisualElement>

                <ui:VisualElement class="chat-actions">
                    <ui:Button name="chat-access" text="ACCESS" class="req-btn req-btn--approve" />
                    <ui:Button name="chat-decline" text="DECLINE" class="req-btn req-btn--deny" />
                </ui:VisualElement>

                <ui:VisualElement class="log-sec">
                    <ui:Label text="OPERATION LOG" class="log-head" />
                    <ui:ScrollView name="log-body" class="log-body" />
                </ui:VisualElement>

                <ui:VisualElement name="chat-briefing" class="chat-briefing">
                    <ui:Label text="[O]" class="briefing-icon" />
                    <ui:Label text="OPERATOR BRIEFING" class="briefing-title" />
                    <ui:Label text="Station Alpha — Landing Control Division" class="briefing-sub" />
                    <ui:ScrollView name="briefing-scroll" class="briefing-scroll">
                        <ui:Label name="briefing-body" class="briefing-body" />
                    </ui:ScrollView>
                    <ui:Button name="chat-start-shift" text="START SHIFT" class="briefing-button" />
                </ui:VisualElement>
            </ui:VisualElement>

        </ui:VisualElement>

        <!-- Status bar -->
        <ui:VisualElement name="statusbar" class="statusbar">
            <ui:VisualElement class="sb-l">
                <ui:VisualElement class="sb-ind">
                    <ui:VisualElement name="sb-dot" class="sb-dot" />
                    <ui:Label text="SYSTEM ONLINE" class="sb-text" />
                </ui:VisualElement>
                <ui:Label text="SECTOR 7G" class="sb-text" />
                <ui:Label text="FREQ 142.8 MHz" class="sb-text" />
            </ui:VisualElement>
            <ui:VisualElement class="sb-r">
                <ui:Label name="clock" text="--:--:--" class="sb-text" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Toast popovers (top-right overlay) -->
        <ui:VisualElement name="toast-box" class="toast-box" picking-mode="Ignore" />

    </ui:VisualElement>
</ui:UXML>
