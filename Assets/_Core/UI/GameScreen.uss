:root {
    --bg: rgb(6, 10, 16);
    --bg-secondary: rgb(12, 18, 25);
    --card: rgb(17, 24, 32);
    --card-hover: rgb(22, 31, 43);
    --border: rgb(26, 37, 53);
    --fg: rgb(200, 214, 229);
    --fg-muted: rgb(90, 111, 138);
    --accent: rgb(0, 255, 136);
    --danger: rgb(255, 71, 87);
    --warning: rgb(255, 159, 67);
    --info: rgb(0, 210, 255);
    --terminal-bg: rgb(8, 12, 18);

    /* remap the file-system / request / tag component variables */
    --ra-bg: var(--terminal-bg);
    --ra-panel: rgba(0, 0, 0, 0.15);
    --ra-toolbar: rgba(0, 0, 0, 0.25);
    --ra-border: var(--border);
    --ra-text: var(--fg);
    --ra-text-dim: var(--fg-muted);
    --ra-accent: var(--accent);
    --ra-row-hover: rgba(0, 255, 136, 0.05);
    --ra-row-selected: rgba(0, 255, 136, 0.12);
}

.app {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: var(--bg);
    -unity-font-definition: url("../Fonts/SpaceGrotesk-Regular.ttf");
}

/* Monospace voice for terminal/data text (mockup: JetBrains Mono) */
.terminal-title,
.stat-value,
.sb-text,
.log-t,
.log-m,
.chat-id,
.chat-timer,
.msg--sys > .msg-b {
    -unity-font-definition: url("../Fonts/JetBrainsMono-Regular.ttf");
}

/* ---- effect layers (populated in C# via Painter2D) ---- */
.fx-starfield {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}
.fx-scanlines {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

/* ========================= Top bar ========================= */
.topbar {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding-left: 18px;
    padding-right: 18px;
    height: 44px;
    background-color: rgba(12, 18, 25, 0.92);
    border-bottom-width: 1px;
    border-bottom-color: var(--border);
    flex-shrink: 0;
}
.topbar-left { flex-direction: row; align-items: center; }
.station-logo {
    width: 26px; height: 26px;
    border-width: 2px; border-color: var(--accent); border-radius: 13px;
    -unity-text-align: middle-center;
    font-size: 11px; color: var(--accent);
    margin-right: 10px;
}
.station-name {
    font-size: 14px; -unity-font-style: bold;
    letter-spacing: 2px; color: var(--accent);
    margin: 0; padding: 0;
}
.station-sub {
    font-size: 8px; color: var(--fg-muted); letter-spacing: 2px;
    margin: 0; padding: 0; margin-top: -1px;
}
.topbar-stats { flex-direction: row; align-items: flex-start; padding-top: 4px; }
.stat-group {
    align-items: flex-end;
    margin-left: 20px;
}
.stat-header {
    font-size: 8px;
    color: var(--fg-muted);
    letter-spacing: 1px;
    margin-bottom: -2px;
}
.stat-value { font-size: 18px; -unity-font-style: bold; color: var(--accent); margin-top: -3px; }
.stat-value--danger { color: var(--danger); }
.stat-value--info { color: var(--info); }
.integrity-container {
    align-items: flex-end;
    margin-left: 24px;
}
.integrity-bar {
    flex-direction: row;
    margin-top: 8px;
}
.integrity-dot {
    width: 14px;
    height: 10px;
    margin-left: 4px;
    border-radius: 2px;
    border-width: 1px;
    border-color: var(--border);
    flex-shrink: 0;
}
.integrity-dot--full {
    background-color: var(--accent);
    border-color: var(--accent);
}
.integrity-dot--empty {
    background-color: rgba(255, 71, 87, 0.15);
    border-color: var(--danger);
}

/* ========================= Main split ========================= */
.main-content { flex-grow: 1; flex-direction: row; }

.game-screen__fill { flex-grow: 1; }

/* ---- Left: terminal ---- */
.terminal-panel {
    width: 42%; min-width: 320px;
    border-right-width: 1px; border-right-color: var(--border);
    background-color: var(--terminal-bg);
}
.terminal-panel .ra-window {
    border-width: 0;
    background-color: transparent;
}
.terminal-header {
    flex-direction: row; align-items: center;
    height: 34px; padding-left: 16px;
    background-color: rgba(0, 0, 0, 0.35);
    border-bottom-width: 1px; border-bottom-color: var(--border);
}
.td { width: 10px; height: 10px; border-radius: 5px; margin-right: 6px; flex-shrink: 0; align-self: center; }
.td--r { background-color: rgb(255, 95, 87); }
.td--y { background-color: rgb(255, 189, 46); }
.td--g { background-color: rgb(40, 201, 64); }
.terminal-title {
    font-size: 11px; color: var(--fg-muted); letter-spacing: 1px; margin-left: 8px;
}

/* ---- Right: requests ---- */
.request-panel {
    flex-grow: 1;
    background-color: rgba(6, 10, 16, 0.5);
}
/* ---- Chat header (signal bars + request id + countdown) ---- */
.chat-header {
    flex-direction: row; align-items: center; justify-content: space-between;
    height: 40px; padding-left: 18px; padding-right: 18px;
    background-color: rgba(0, 0, 0, 0.25);
    border-bottom-width: 1px; border-bottom-color: var(--border);
}
.chat-header__left { flex-direction: row; align-items: center; }
.chat-signal { flex-direction: row; align-items: flex-end; margin-right: 10px; }
.sig-bar {
    width: 3px; margin-right: 2px; border-radius: 1px;
    background-color: var(--border);
    transition-property: background-color; transition-duration: 0.5s;
}
.sig-bar--on { background-color: var(--accent); }
.chat-id { font-size: 10px; color: var(--fg-muted); }
.chat-timer { font-size: 16px; -unity-font-style: bold; color: rgb(255, 255, 255); }
.chat-timer--warn { color: var(--warning); }
.chat-timer--crit { color: var(--danger); }

/* ---- Messages ---- */
.chat-messages {
    flex-grow: 1;
    height: 0;
    min-height: 0;
    padding: 10px 16px;
}
.msg {
    flex-direction: row; align-items: flex-end;
    max-width: 82%;
    margin-top: 4px; margin-bottom: 4px;
    align-self: flex-start;
    opacity: 0; translate: 0 8px;
    transition-property: opacity, translate; transition-duration: 0.25s;
    transition-timing-function: ease-out;
}
.msg--in { opacity: 1; translate: 0 0; }
.msg--op { align-self: flex-end; flex-direction: row-reverse; }
.msg--sys { align-self: center; max-width: 100%; }
.msg-av {
    width: 26px; height: 26px; border-radius: 13px;
    -unity-text-align: middle-center; font-size: 11px;
    margin-right: 8px; flex-shrink: 0;
}
.msg--op > .msg-av { margin-right: 0; margin-left: 8px; background-color: rgba(0, 255, 136, 0.12); }
.msg--pilot > .msg-av { background-color: rgba(0, 210, 255, 0.12); }
.msg-b {
    padding: 8px 12px; border-radius: 10px;
    font-size: 12px; color: var(--fg); white-space: normal;
}
.msg--pilot > .msg-b {
    background-color: var(--card);
    border-width: 1px; border-color: var(--border);
    border-bottom-left-radius: 3px;
}
.msg--op > .msg-b {
    background-color: rgba(0, 255, 136, 0.1);
    border-width: 1px; border-color: rgba(0, 255, 136, 0.18);
    border-bottom-right-radius: 3px;
}
.msg--sys > .msg-b {
    background-color: rgba(0, 0, 0, 0); border-width: 0;
    color: var(--fg-muted); font-size: 10px;
    -unity-text-align: middle-center;
}

/* ---- Typing indicator row ---- */
.chat-typing { display: none; padding-left: 16px; margin-bottom: 4px; opacity: 1; translate: 0 0; }
.typing-bubble {
    flex-direction: row; align-items: center;
    padding: 9px 12px;
    background-color: var(--card);
    border-width: 1px; border-color: var(--border);
    border-radius: 10px; border-bottom-left-radius: 3px;
}
.typing-bubble__dot {
    width: 5px; height: 5px; border-radius: 3px;
    background-color: var(--fg-muted); margin-right: 3px;
}

.chat-briefing {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    background-color: rgb(8, 12, 18);
    align-items: center;
    justify-content: center;
    padding: 22px 26px;
}
.briefing-icon {
    font-size: 28px; color: var(--accent);
    opacity: 0.75; margin-bottom: 8px;
}
.briefing-title {
    font-size: 18px; -unity-font-style: bold;
    color: rgb(255, 255, 255); letter-spacing: 1px;
}
.briefing-sub {
    font-size: 11px; color: var(--fg-muted);
    letter-spacing: 1px; margin-bottom: 14px;
}
.briefing-scroll {
    flex-grow: 1; width: 100%;
    margin-bottom: 14px;
}
.briefing-body {
    font-size: 12px; color: var(--fg);
    white-space: normal;
}
.briefing-button {
    height: 38px; padding-left: 30px; padding-right: 30px;
    background-color: rgba(0, 255, 136, 0.1);
    border-width: 1px; border-color: rgba(0, 255, 136, 0.3);
    border-radius: 7px;
    color: var(--accent);
    font-size: 13px; -unity-font-style: bold; letter-spacing: 2px;
    transition-duration: 0.2s;
}
.briefing-button:hover {
    background-color: rgba(0, 255, 136, 0.22);
    border-color: var(--accent);
}

/* ---- Input + actions ---- */
.chat-input-row {
    flex-direction: row; align-items: center;
    padding: 8px 16px 6px;
    border-top-width: 1px; border-top-color: var(--border);
    background-color: rgba(0, 0, 0, 0.2);
}
.chat-input { flex-grow: 1; margin: 0 8px 0 0; }
.chat-input > .unity-text-field__input {
    background-color: rgba(0, 0, 0, 0.4);
    border-width: 1px; border-color: var(--border); border-radius: 6px;
    color: var(--fg); font-size: 12px;
    padding: 7px 12px;
    transition-property: border-color; transition-duration: 0.2s;
    --unity-cursor-color: var(--accent);
    --unity-selection-color: rgba(0, 255, 136, 0.25);
}
.chat-input > .unity-text-field__input:focus { border-color: rgba(0, 255, 136, 0.35); }
.chat-send {
    width: 44px; height: 30px;
    background-color: rgba(0, 255, 136, 0.12);
    border-width: 1px; border-color: rgba(0, 255, 136, 0.2); border-radius: 6px;
    color: var(--accent); font-size: 13px;
}
.chat-send:hover { background-color: rgba(0, 255, 136, 0.2); border-color: var(--accent); }
.chat-actions { flex-direction: row; padding: 6px 16px 10px; }

/* action buttons */
.req-btn {
    flex-grow: 1; height: 30px; margin-right: 10px;
    border-width: 1px; border-radius: 8px;
    font-size: 12px; -unity-font-style: bold; letter-spacing: 1px;
    transition-duration: 0.15s;
}
.req-btn--approve {
    color: var(--accent);
    background-color: rgba(0, 255, 136, 0.1);
    border-color: rgba(0, 255, 136, 0.28);
}
.req-btn--approve:hover { background-color: rgba(0, 255, 136, 0.22); border-color: var(--accent); }
.req-btn--deny {
    color: var(--danger);
    background-color: rgba(255, 71, 87, 0.1);
    border-color: rgba(255, 71, 87, 0.28);
    margin-right: 0;
}
.req-btn--deny:hover { background-color: rgba(255, 71, 87, 0.22); border-color: var(--danger); }
.req-btn:disabled { opacity: 0.4; }

/* ========================= Operation Log ========================= */
.log-sec {
    height: 150px;
    border-top-width: 1px; border-top-color: var(--border);
    background-color: rgba(0, 0, 0, 0.3);
}
.log-head {
    height: 24px; padding-left: 24px; -unity-text-align: middle-left;
    font-size: 9px; letter-spacing: 3px; color: var(--fg-muted);
    border-bottom-width: 1px; border-bottom-color: var(--border);
}
.log-body {
    flex-grow: 1;
    height: 0;
    min-height: 0;
    padding-left: 24px;
    padding-right: 24px;
    padding-top: 4px;
    padding-bottom: 4px;
}
.log-entry {
    flex-direction: row; margin-top: 1px; margin-bottom: 1px;
    opacity: 0;
    translate: -8px 0;
    transition-property: opacity, translate;
    transition-duration: 0.25s;
    transition-timing-function: ease-out;
}
.log-entry--in { opacity: 1; translate: 0 0; }
.log-t { font-size: 11px; color: var(--fg-muted); margin-right: 8px; flex-shrink: 0; }
.log-m { font-size: 11px; color: var(--fg); white-space: normal; flex-grow: 1; }
.log-m--accent { color: var(--accent); }
.log-m--danger { color: var(--danger); }
.log-m--warning { color: var(--warning); }
.log-m--info { color: var(--info); }

/* ========================= Scrollbars (game-styled, thin & dark) ========================= */
.unity-scroller--vertical {
    width: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.unity-scroller--horizontal {
    height: 8px;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}
.unity-scroller__low-button,
.unity-scroller__high-button {
    display: none;
}
.unity-scroller--vertical > .unity-scroller__slider {
    margin-top: 0; margin-bottom: 0; width: 8px;
}
.unity-scroller--horizontal > .unity-scroller__slider {
    margin-left: 0; margin-right: 0; height: 8px;
}
.unity-base-slider__tracker {
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
}
.unity-base-slider__dragger {
    background-color: var(--border);
    border-width: 0;
    border-radius: 3px;
}
.unity-scroller--vertical .unity-base-slider__dragger { width: 6px; left: 1px; }
.unity-scroller--horizontal .unity-base-slider__dragger { height: 6px; top: 1px; }
.unity-base-slider__dragger:hover {
    background-color: rgba(0, 255, 136, 0.35);
}

/* ========================= Toasts ========================= */
.toast-box {
    position: absolute;
    top: 52px; right: 20px;
}
.toast {
    padding: 10px 18px;
    margin-bottom: 6px;
    border-radius: 8px;
    border-width: 1px;
    font-size: 12px;
    opacity: 0;
    translate: 30px 0;
    transition-property: opacity, translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out;
}
.toast--in { opacity: 1; translate: 0 0; }
.toast--out { opacity: 0; translate: 0 -8px; }
.toast--ok {
    background-color: rgba(0, 255, 136, 0.13);
    border-color: rgba(0, 255, 136, 0.28);
    color: var(--accent);
}
.toast--err {
    background-color: rgba(255, 71, 87, 0.13);
    border-color: rgba(255, 71, 87, 0.28);
    color: var(--danger);
}
.toast--nfo {
    background-color: rgba(0, 210, 255, 0.13);
    border-color: rgba(0, 210, 255, 0.28);
    color: var(--info);
}

/* ========================= Status bar ========================= */
.statusbar {
    flex-direction: row; align-items: center; justify-content: space-between;
    height: 24px; padding-left: 24px; padding-right: 24px;
    background-color: rgba(12, 18, 25, 0.95);
    border-top-width: 1px; border-top-color: var(--border);
    flex-shrink: 0;
}
.sb-l, .sb-r { flex-direction: row; align-items: center; }
.sb-l > Label, .sb-r > Label { font-size: 10px; color: var(--fg-muted); margin-right: 18px; }
.sb-ind { flex-direction: row; align-items: center; margin-right: 18px; }
.sb-dot { width: 5px; height: 5px; border-radius: 3px; background-color: var(--accent); margin-right: 5px; }
.sb-text { font-size: 10px; color: var(--fg-muted); }
