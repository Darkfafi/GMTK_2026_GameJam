:root {
    --ra-bg: rgb(8, 12, 18);
    --ra-panel: rgba(0, 0, 0, 0.15);
    --ra-toolbar: rgba(0, 0, 0, 0.25);
    --ra-border: rgb(26, 37, 53);
    --ra-text: rgb(200, 214, 229);
    --ra-text-dim: rgb(90, 111, 138);
    --ra-accent: rgb(0, 255, 136);
    --ra-row-hover: rgba(0, 255, 136, 0.045);
    --ra-row-selected: rgba(0, 255, 136, 0.12);
}

.ra-window {
    flex-grow: 1;
    min-width: 320px;
    min-height: 240px;
    background-color: var(--ra-bg);
    border-width: 1px;
    border-color: var(--ra-border);
    overflow: hidden;
}

/* Monospace voice for the terminal (mockup: JetBrains Mono) */
.ra-crumb,
.ra-crumb-separator,
.ra-entity__label,
.ra-entity__size,
.ra-status-label,
.fc-text {
    -unity-font-definition: url("../Fonts/JetBrainsMono-Regular.ttf");
}

/* -------- Toolbar (back button + breadcrumb) -------- */

.ra-toolbar {
    flex-direction: row;
    align-items: center;
    height: 34px;
    padding-left: 6px;
    padding-right: 6px;
    background-color: var(--ra-toolbar);
    border-bottom-width: 1px;
    border-bottom-color: var(--ra-border);
}

.ra-back-button {
    width: 26px;
    height: 24px;
    margin-right: 6px;
    -unity-text-align: middle-center;
    font-size: 15px;
    color: var(--ra-text);
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 0;
    border-radius: 4px;
}

.ra-back-button:hover {
    background-color: rgba(255, 255, 255, 0.10);
}

.ra-back-button:disabled {
    color: var(--ra-text-dim);
    opacity: 0.4;
}

.ra-breadcrumb {
    flex-direction: row;
    flex-grow: 1;
    flex-wrap: wrap;
    align-items: center;
}

.ra-crumb {
    color: var(--ra-text-dim);
    font-size: 13px;
    padding-left: 4px;
    padding-right: 4px;
    background-color: transparent;
    border-width: 0;
}

.ra-crumb:hover {
    color: var(--ra-accent);
}

.ra-crumb--current {
    color: var(--ra-accent);
    -unity-font-style: bold;
}

.ra-crumb-separator {
    color: var(--ra-text-dim);
    font-size: 12px;
    -unity-text-align: middle-center;
}

/* -------- Contents list -------- */

.ra-contents {
    flex-grow: 1;
    background-color: var(--ra-panel);
}

.ra-empty-label {
    -unity-text-align: middle-center;
    color: var(--ra-text-dim);
    font-size: 13px;
    padding-top: 24px;
}

/* -------- A single entity row -------- */

.ra-entity {
    flex-direction: row;
    align-items: center;
    height: 32px;
    padding-left: 13px;
    padding-right: 13px;
    border-radius: 6px;
    border-width: 1px;
    border-color: rgba(0, 0, 0, 0);
    margin-left: 4px;
    margin-right: 4px;
    margin-top: 1px;
    margin-bottom: 1px;
}

.ra-entity:hover {
    background-color: var(--ra-row-hover);
    border-color: rgba(0, 255, 136, 0.12);
}

.ra-entity--selected {
    background-color: var(--ra-row-selected);
}

.ra-entity__icon {
    width: 18px;
    -unity-text-align: middle-center;
    font-size: 15px;
    margin-right: 8px;
}

.ra-entity__label {
    flex-grow: 1;
    color: var(--ra-text);
    font-size: 13px;
    -unity-text-align: middle-left;
}

.ra-entity__size {
    font-size: 10px;
    color: var(--ra-text-dim);
    opacity: 0.55;
    margin-left: 8px;
}

/* typed icon tints (mockup: folder = warning, file = info, image = pink) */
.ra-entity__icon--folder { color: rgb(255, 159, 67); }
.ra-entity__icon--file { color: rgb(0, 210, 255); }
.ra-entity__icon--image { color: rgb(224, 86, 160); }

.ra-entity--folder .ra-entity__label {
    -unity-font-style: bold;
}

/* -------- File content reader (fc) -------- */

.fc {
    display: none;
    flex-grow: 1;
    padding: 16px;
    border-top-width: 1px;
    border-top-color: var(--ra-border);
}

.fc-scroll {
    flex-grow: 1;
}

.fc-text {
    font-size: 12px;
    color: var(--ra-text);
    white-space: normal;
}

/* -------- Status bar -------- */

.ra-statusbar {
    height: 22px;
    flex-direction: row;
    align-items: center;
    padding-left: 10px;
    background-color: var(--ra-toolbar);
    border-top-width: 1px;
    border-top-color: var(--ra-border);
}

.ra-status-label {
    color: var(--ra-text-dim);
    font-size: 11px;
}
